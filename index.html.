<div class="prototype-message" id="connectionStatus"><span>ⓘ</span><p>Para activar a ligação, configura o Project URL e a Publishable key do teu projecto Supabase abaixo. Nunca uses uma chave secret ou service_role.</p></div>
<form id="connectionForm"><label>Project URL<input id="supabaseUrl" type="url" placeholder="https://xxxx.supabase.co" required></label><label>Publishable key<input id="supabaseKey" type="text" placeholder="sb_publishable_..." required></label><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar ligação</button></div></form>
<div class="divider" style="height:1px;background:#e7ebf1;margin:18px 0"></div>
<form id="authForm"><label>E-mail<input id="authEmail" type="email" autocomplete="email" required placeholder="teuemail@exemplo.com"></label><label>Palavra-passe<input id="authPassword" type="password" autocomplete="current-password" minlength="6" required placeholder="Pelo menos 6 caracteres"></label><div class="form-actions"><button class="btn btn-light" type="button" id="signInBtn">Entrar</button><button class="btn btn-primary" type="button" id="signUpBtn">Criar conta</button></div></form>
<button class="btn btn-outline full-width" id="signOutBtn" type="button" style="margin-top:10px">Terminar sessão</button>
</div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const STORAGE_KEY = 'biscato_mvp_listings_v1';
const sampleListings = [
 {id:'demo-1',type:'Pedido de serviço',category:'Limpeza',title:'Preciso de limpeza para quintal',description:'Procuro uma pessoa responsável para limpar e organizar um quintal pequeno. Material básico disponível. Idealmente esta semana.',location:'Talatona',budget:12000,author:'Marta C.',phone:'923000001',featured:true,createdAt:Date.now()-1000*60*35},
 {id:'demo-2',type:'Ofereço serviço',category:'Reparações',title:'Eletricista disponível para pequenos serviços',description:'Faço instalação de tomadas, troca de lâmpadas, verificação de disjuntores e pequenas reparações domésticas.',location:'Camama',budget:8000,author:'João Manuel',phone:'923000002',featured:false,createdAt:Date.now()-1000*60*80},
 {id:'demo-3',type:'Pedido de serviço',category:'Mudanças',title:'Ajuda para transportar móveis',description:'Preciso de duas pessoas para ajudar a carregar cama, sofá e algumas caixas. O transporte já está assegurado.',location:'Patriota',budget:18000,author:'Casa Nova',phone:'923000003',featured:false,createdAt:Date.now()-1000*60*60*4},
 {id:'demo-4',type:'Ofereço serviço',category:'Explicações',title:'Explicações de Matemática e Física',description:'Estudante universitário dá explicações para alunos do ensino médio. Horários flexíveis e acompanhamento individual.',location:'Maianga',budget:5000,author:'Ana P.',phone:'923000004',featured:false,createdAt:Date.now()-1000*60*60*7},
 {id:'demo-5',type:'Pedido de serviço',category:'Jardinagem',title:'Manutenção de jardim de residência',description:'Procuro alguém com experiência para cortar relva, podar plantas e deixar o jardim limpo. Enviar proposta com disponibilidade.',location:'Benfica',budget:15000,author:'Residência K.',phone:'923000005',featured:false,createdAt:Date.now()-1000*60*60*10},
 {id:'demo-6',type:'Ofereço serviço',category:'Construção',title:'Ajudante de pedreiro disponível',description:'Disponível para biscates em obras: preparação de massa, transporte de material, limpeza de obra e apoio geral.',location:'Viana',budget:10000,author:'Carlos A.',phone:'923000006',featured:false,createdAt:Date.now()-1000*60*60*16}
];
let listings = loadListings(); let activeCategory = 'Todos'; let toastTimer; let dbClient = null; let currentSession = null;
const $ = id => document.getElementById(id);
function loadListings(){try{const raw=localStorage.getItem(STORAGE_KEY);return raw?JSON.parse(raw):sampleListings.slice()}catch{return sampleListings.slice()}}
function saveListings(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(listings));return true}catch{return false}}
function getConnection(){try{return JSON.parse(localStorage.getItem('biscato_supabase_config')||'null')}catch{return null}}
function setConnectionStatus(message){const el=$('connectionStatus');if(el)el.innerHTML='<span>ⓘ</span><p>'+escapeHtml(message)+'</p>'}
function initSupabase(){
  const cfg=getConnection();
  if(!cfg||!cfg.url||!cfg.key||!window.supabase||!cfg.url.startsWith('https://')){dbClient=null;return false}
  try{dbClient=window.supabase.createClient(cfg.url,cfg.key);$('supabaseUrl').value=cfg.url;$('supabaseKey').value=cfg.key;setConnectionStatus('Configuração guardada neste navegador. A testar a ligação…');return true}catch(e){dbClient=null;return false}
}
async function refreshListings(){
  if(!dbClient){render();return}
  try{
    const {data: publicRows,error}=await dbClient.from('listings').select('id,user_id,type,category_id,title,description,location,budget,contact_phone,status,created_at,categories(name)').eq('status','published').order('created_at',{ascending:false});
    if(error)throw error;
    let rows=(publicRows||[]);
    if(currentSession){
      const {data: ownRows,error:ownError}=await dbClient.from('listings').select('id,user_id,type,category_id,title,description,location,budget,contact_phone,status,created_at,categories(name)').eq('user_id',currentSession.user.id).order('created_at',{ascending:false});
      if(!ownError){const seen=new Set(rows.map(x=>x.id));rows=rows.concat((ownRows||[]).filter(x=>!seen.has(x.id)))}
    }
    listings=rows.map(x=>({id:x.id,type:x.type==='offer'?'Ofereço serviço':'Pedido de serviço',category:x.categories?.name||'Outros',title:x.title,description:x.description,location:x.location,budget:Number(x.budget)||0,author:(currentSession&&currentSession.user.id===x.user_id)?(currentSession.user.user_metadata?.display_name||'A minha conta'):'Utilizador Biscato',phone:x.contact_phone,featured:false,createdAt:new Date(x.created_at).getTime(),status:x.status}));
    render();
    if(currentSession){setConnectionStatus('Sessão activa como '+(currentSession.user.email||'utilizador')+'. Já podes publicar anúncios; os anúncios aguardam aprovação antes de aparecerem publicamente.')}else{setConnectionStatus('Ligação activa ao Supabase. Para publicar ou gerir anúncios, entra na tua conta.');}
  }catch(err){const detail=(err&&err.message)?err.message:String(err||'Erro desconhecido');setConnectionStatus('Erro ao carregar anúncios: '+detail);console.error('Biscato/Supabase:',err);render()}
}
function updateAuthUI(){
  const button=$('loginBtn');
  if(button) button.textContent=currentSession ? 'Conta activa' : 'Entrar';
  const status=$('connectionStatus');
  if(status && currentSession){
    status.innerHTML='<span>✓</span><p>Sessão activa como <strong>'+escapeHtml(currentSession.user.email||'utilizador')+'</strong>. Já podes publicar anúncios; os teus anúncios aguardam aprovação antes de aparecerem publicamente.</p>';
  }
}
async function refreshSession(){
  if(!dbClient)return;
  const {data}=await dbClient.auth.getSession();currentSession=data?.session||null;
  updateAuthUI();
  checkBiscatoAdmin();
  if(!window.biscatoAuthListener && dbClient.auth.onAuthStateChange){
    window.biscatoAuthListener=true;
    dbClient.auth.onAuthStateChange((_event,session)=>{currentSession=session;updateAuthUI();checkBiscatoAdmin();refreshListings()});
  }
  refreshListings();
}

async function checkBiscatoAdmin(){
  const button=$('adminTopBtn');
  if(!button)return;
  button.classList.add('hidden');
  if(!dbClient||!currentSession)return;
  try{
    const {data,error}=await dbClient.rpc('is_biscato_admin');
    if(error)throw error;
    if(data===true){
      button.classList.remove('hidden');
      button.onclick=()=>{ $('adminPanel').classList.remove('hidden'); $('adminPanel').scrollIntoView({behavior:'smooth',block:'start'}); loadAdminListings(); };
    }
  }catch(err){
    console.warn('Biscato admin check:',err);
  }
}
async function loadAdminListings(){
  const list=$('adminListings'), message=$('adminMessage');
  if(!dbClient||!currentSession){message.textContent='Inicia sessão para aceder à administração.';return}
  message.textContent='A carregar anúncios pendentes…';
  list.innerHTML='';
  try{
    const {data:isAdmin,error:adminError}=await dbClient.rpc('is_biscato_admin');
    if(adminError)throw adminError;
    if(isAdmin!==true){message.textContent='Esta conta não tem autorização de administrador.';return}
    const {data,error}=await dbClient.from('listings')
      .select('id,type,title,description,location,budget,contact_phone,status,created_at,categories(name)')
      .eq('status','pending').order('created_at',{ascending:true});
    if(error)throw error;
    const rows=data||[];
    $('adminResultCount').textContent=rows.length+' anúncio(s) pendente(s)';
    $('adminEmpty').classList.toggle('hidden',rows.length>0);
    message.textContent=rows.length?'Selecciona uma decisão para cada anúncio.':'';
    list.innerHTML=rows.map(item=>`
      <article class="admin-card" data-admin-id="${escapeHtml(item.id)}">
        <div class="card-top"><span class="type-pill">${item.type==='offer'?'Serviço oferecido':'Pedido de serviço'}</span><span class="card-category">${escapeHtml(item.categories?.name||'Outros')}</span></div>
        <h3>${escapeHtml(item.title||'Sem título')}</h3>
        <p>${escapeHtml(item.description||'')}</p>
        <div class="admin-meta">Zona: ${escapeHtml(item.location||'Não indicada')} · Orçamento: ${money(Number(item.budget)||0)} · ${relativeDate(new Date(item.created_at).getTime())}</div>
        <div class="admin-actions">
          <button class="btn btn-success" type="button" data-admin-action="published">Aprovar</button>
          <button class="btn btn-danger" type="button" data-admin-action="rejected">Rejeitar</button>
        </div>
      </article>`).join('');
  }catch(err){
    console.error('Biscato admin listings:',err);
    message.textContent='Não foi possível carregar os anúncios. Verifica as políticas de acesso no Supabase.';
  }
}
$('adminRefreshBtn')?.addEventListener('click',loadAdminListings);
$('adminListings')?.addEventListener('click',async e=>{
  const button=e.target.closest('[data-admin-action]');
  if(!button)return;
  const card=button.closest('[data-admin-id]');
  const id=card?.getAttribute('data-admin-id');
  const status=button.getAttribute('data-admin-action');
  if(!id||!['published','rejected'].includes(status))return;
  button.disabled=true;
  try{
    const {data:isAdmin,error:adminError}=await dbClient.rpc('is_biscato_admin');
    if(adminError)throw adminError;
    if(isAdmin!==true)throw new Error('Conta sem autorização de administrador.');
    const {error}=await dbClient.from('listings').update({status}).eq('id',id);
    if(error)throw error;
    showToast(status==='published'?'Anúncio aprovado e publicado.':'Anúncio rejeitado.');
    await loadAdminListings();
    await refreshListings();
  }catch(err){
    console.error('Biscato moderation:',err);
    showToast('Não foi possível actualizar o anúncio. Verifica as permissões.');
    button.disabled=false;
  }
});

function money(value){return value?new Intl.NumberFormat('pt-AO',{maximumFractionDigits:0}).format(value)+' Kz':'A combinar'}
function escapeHtml(value=''){return String(value).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]))}
function relativeDate(time){const mins=Math.max(1,Math.floor((Date.now()-time)/60000));if(mins<60)return `há ${mins} min`;const hrs=Math.floor(mins/60);if(hrs<24)return `há ${hrs} h`;return `há ${Math.floor(hrs/24)} d`}
function filteredListings(){const query=$('searchInput').value.trim().toLocaleLowerCase('pt');const type=$('typeFilter').value;const location=$('locationFilter').value;const sort=$('sortFilter').value;let rows=listings.filter(item=>{const hay=[item.title,item.description,item.category,item.location,item.author].join(' ').toLocaleLowerCase('pt');return (!query||hay.includes(query))&&(activeCategory==='Todos'||item.category===activeCategory)&&(type==='Todos'||item.type===type)&&(location==='Todas'||item.location===location)});if(sort==='low')rows.sort((a,b)=>(a.budget||Infinity)-(b.budget||Infinity));else if(sort==='high')rows.sort((a,b)=>(b.budget||0)-(a.budget||0));else rows.sort((a,b)=>(Number(b.featured)-Number(a.featured))||b.createdAt-a.createdAt);return rows}
function render(){const rows=filteredListings();$('resultCount').textContent=`${rows.length} ${rows.length===1?'anúncio encontrado':'anúncios encontrados'}`;$('listingGrid').innerHTML=rows.map(item=>{const isOffer=item.type==='Ofereço serviço';const initials=item.author.split(/\s+/).slice(0,2).map(s=>s[0]||'').join('').toUpperCase();const phone=String(item.phone||'').replace(/\D/g,'');const message=encodeURIComponent(`Olá ${item.author}, encontrei o teu anúncio "${item.title}" no Biscato. Gostaria de saber mais.`);const contactHref=phone?`https://wa.me/${phone.startsWith('244')?phone:'244'+phone.replace(/^0/,'')}?text=${message}`:'#';return `<article class="listing-card ${item.featured?'featured':''}"><div class="card-top"><span class="type-pill ${isOffer?'offer':''}">${isOffer?'✦ Serviço oferecido':'⌕ Pedido de serviço'}</span>${item.featured?'<span class="featured-pill">★ Destaque</span>':`<span class="card-category">${escapeHtml(item.category)}</span>`}</div><h3>${escapeHtml(item.title)}</h3><p class="card-description">${escapeHtml(item.description)}</p><div class="card-meta"><span>⌖ ${escapeHtml(item.location)}</span><span>◷ ${relativeDate(item.createdAt)}</span></div><div class="card-footer"><div class="author"><span class="author-avatar">${escapeHtml(initials||'B')}</span><span class="author-name">${escapeHtml(item.author)}</span></div><div class="card-price">${money(Number(item.budget))}<small>${item.budget?'orçamento indicativo':'preço'}</small></div></div><a class="contact-btn" href="${contactHref}" ${phone?'target="_blank" rel="noopener noreferrer"':'aria-disabled="true"'} data-contact="${escapeHtml(item.id)}">${phone?'Contactar no WhatsApp':'Contacto não indicado'} ↗</a></article>`}).join('');$('emptyState').classList.toggle('hidden',rows.length>0);$('listingGrid').classList.toggle('hidden',rows.length===0)}
function showToast(message){const toast=$('toast');toast.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),3200)}
function openModal(){ $('postModal').classList.remove('hidden');document.body.style.overflow='hidden';setTimeout(()=>$('postForm').elements.title.focus(),50)}
function closeModal(){ $('postModal').classList.add('hidden');document.body.style.overflow=''}
function openLogin(){ $('loginModal').classList.remove('hidden');document.body.style.overflow='hidden'}
function closeLogin(){ $('loginModal').classList.add('hidden');document.body.style.overflow=''}
['postTopBtn','heroPostBtn','postListBtn','ctaPostBtn','emptyPostBtn'].forEach(id=>$(id).addEventListener('click',openModal));$('closeModal').addEventListener('click',closeModal);$('cancelModal').addEventListener('click',closeModal);$('loginBtn').addEventListener('click',openLogin);$('closeLogin').addEventListener('click',closeLogin);
$('connectionForm').addEventListener('submit',e=>{e.preventDefault();const url=$('supabaseUrl').value.trim().replace(/\/$/,'');const key=$('supabaseKey').value.trim();if(!url.startsWith('https://')||!key){showToast('Confirma o Project URL e a Publishable key.');return}localStorage.setItem('biscato_supabase_config',JSON.stringify({url,key}));if(initSupabase()){showToast('Configuração guardada. A testar ligação…');refreshSession()}else{showToast('Não foi possível iniciar a ligação.');}});
$('signInBtn').addEventListener('click',async()=>{if(!dbClient){showToast('Guarda primeiro o Project URL e a Publishable key.');return}const email=$('authEmail').value.trim(),password=$('authPassword').value;if(!email||!password){showToast('Preenche o e-mail e a palavra-passe.');return}const {data,error}=await dbClient.auth.signInWithPassword({email,password});if(error){showToast('Não foi possível entrar. Confirma os dados e a confirmação do e-mail.');return}const {data:sessionData}=await dbClient.auth.getSession();currentSession=data?.session||sessionData?.session||null;updateAuthUI();checkBiscatoAdmin();closeLogin();if(currentSession){showToast('Sessão iniciada. Conta activa.');setConnectionStatus('Sessão activa como '+(currentSession.user.email||'utilizador')+'. Já podes publicar anúncios; os anúncios aguardam aprovação antes de aparecerem publicamente.');}else{showToast('O Supabase respondeu, mas não devolveu uma sessão activa. Verifica a confirmação do e-mail e as definições de autenticação.')}await refreshListings();updateAuthUI()});
$('signUpBtn').addEventListener('click',async()=>{if(!dbClient){showToast('Guarda primeiro o Project URL e a Publishable key.');return}const email=$('authEmail').value.trim(),password=$('authPassword').value;if(!email||password.length<6){showToast('Indica um e-mail válido e uma palavra-passe com pelo menos 6 caracteres.');return}const {error,data}=await dbClient.auth.signUp({email,password});if(error){showToast('Não foi possível criar a conta. Confirma os dados.');return}if(data.session){currentSession=data.session;showToast('Conta criada e sessão iniciada.');closeLogin();checkBiscatoAdmin();refreshListings()}else{showToast('Conta criada. Verifica o teu e-mail para confirmar o registo.')}});
$('signOutBtn').addEventListener('click',async()=>{if(!dbClient){showToast('Ainda não existe ligação configurada.');return}const {error}=await dbClient.auth.signOut();if(error){showToast('Não foi possível terminar a sessão.');return}currentSession=null;updateAuthUI();showToast('Sessão terminada.');refreshListings()});$('postModal').addEventListener('click',e=>{if(e.target===$('postModal'))closeModal()});$('loginModal').addEventListener('click',e=>{if(e.target===$('loginModal'))closeLogin()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeLogin()}});
$('postForm').addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget;const data=new FormData(form);const title=String(data.get('title')||'').trim();const description=String(data.get('description')||'').trim();const author=String(data.get('author')||'').trim();const phone=String(data.get('phone')||'').trim();if(!title||!description||!author||!phone){showToast('Preenche os campos obrigatórios.');return}
if(dbClient){
  if(!currentSession){showToast('Entra ou cria uma conta antes de publicar.');closeModal();openLogin();return}
  try{
    const categoryName=String(data.get('category'));
    const {data:cat,error:catErr}=await dbClient.from('categories').select('id').eq('name',categoryName).maybeSingle();
    if(catErr)throw catErr;
    const item={user_id:currentSession.user.id,type:String(data.get('type'))==='Ofereço serviço'?'offer':'request',category_id:cat?.id||null,title,description,location:String(data.get('location')),budget:Number(data.get('budget'))||null,contact_phone:phone,status:'pending'};
    const {error}=await dbClient.from('listings').insert(item);if(error)throw error;
    form.reset();closeModal();await refreshListings();showToast('Anúncio enviado! Ficará visível depois da aprovação.');$('explorar').scrollIntoView({behavior:'smooth',block:'start'});
  }catch(err){console.error(err);showToast('Não foi possível publicar. Confirma as permissões e os dados.')}
  return;
}
const budget=Number(data.get('budget'))||0;const item={id:'local-'+Date.now(),type:String(data.get('type')),category:String(data.get('category')),title,description,location:String(data.get('location')),budget,author,phone,featured:data.get('featured')==='on',createdAt:Date.now()};listings.unshift(item);const saved=saveListings();form.reset();closeModal();activeCategory='Todos';document.querySelectorAll('.category').forEach(b=>b.classList.toggle('active',b.dataset.category==='Todos'));$('searchInput').value='';$('typeFilter').value='Todos';$('locationFilter').value='Todas';render();$('explorar').scrollIntoView({behavior:'smooth',block:'start'});showToast(saved?'Anúncio publicado neste navegador! Configura o Supabase para partilhá-lo.':'Anúncio criado temporariamente; armazenamento indisponível.');});
$('searchInput').addEventListener('input',render);['typeFilter','locationFilter','sortFilter'].forEach(id=>$(id).addEventListener('change',render));$('categories').addEventListener('click',e=>{const button=e.target.closest('[data-category]');if(!button)return;activeCategory=button.dataset.category;document.querySelectorAll('.category').forEach(b=>b.classList.toggle('active',b===button));render();if(window.innerWidth<700)$('explorar').scrollIntoView({behavior:'smooth',block:'start'})});$('year').textContent=new Date().getFullYear();render();if(initSupabase())refreshSession();

</script>
</body></html>
